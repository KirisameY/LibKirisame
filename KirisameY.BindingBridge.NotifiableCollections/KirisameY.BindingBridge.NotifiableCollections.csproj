<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <!--        <GenerateDocumentationFile>true</GenerateDocumentationFile>-->
        <Version>0.0.1</Version>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/KirisameY/LibKirisame/</RepositoryUrl>
        <RootNamespace>KirisameY.BindingBridge.CollectionBinding</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="KirisameY.BindingBridge" Version="0.1.2" />
      <PackageReference Include="KirisameY.NotifiableCollections" Version="0.1.3" />
    </ItemGroup>

</Project>
